{
  "name": "@kernhq/module-quire",
  "version": "0.1.0",
  "description": "Kern Quire: collaborative documents, spaces and page trees",
  "homepage": "https://kernaio.com",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/KernAIO/modules",
    "directory": "packages/quire"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "migrations",
    "src/client",
    "src/contract"
  ],
  "exports": {
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js",
      "default": "./dist/contract/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "svelte": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./migrations": "./migrations",
    "./client/*": {
      "types": "./src/client/*",
      "svelte": "./src/client/*",
      "default": "./src/client/*"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@kernhq/contracts": "^0.5.0",
    "@kernhq/kernel": "^0.6.0",
    "@kernhq/sdk": "^0.1.0",
    "@orpc/contract": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "drizzle-orm": "^0.45.0",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kernhq/tsconfig": "^0.1.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
